{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "data:import-exercises": "node scripts/import-free-exercise-db.mjs",
    "data:import-turkish-recipes": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-turkish-recipes.mjs",
    "data:generate-turkish-recipes": "node scripts/generate-turkish-recipe-seed.mjs",
    "data:validate-turkish-recipes": "node scripts/import-turkish-recipes.mjs --dry-run",
    "data:sync-plan-media": "node scripts/sync-plan-exercise-media.mjs",
    "db:generate": "drizzle-kit generate",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:doctor": "cap doctor"
  },
  "//overrides": "Güvenlik yamaları: bu paketler geçişli bağımlılık olarak açıklı sürümlerde geliyor (OWASP A06).",
  "overrides": {
    "undici": "^7.28.0",
    "postcss": "^8.5.22",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/network": "^8.0.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@zxing/browser": "^0.2.1",
    "ai": "^7.0.37",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "radix-ui": "^1.6.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
