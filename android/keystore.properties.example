# Bu dosyayı "keystore.properties" olarak kopyalayıp doldurun (o dosya .gitignore'dadır).
# Keystore'u oluşturmak için:
#   keytool -genkeypair -v -keystore hedefit-upload.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias hedefit-upload
# Oluşan .jks dosyasını depo DIŞINDA güvenli bir yerde saklayın ve yedekleyin:
# kaybederseniz aynı uygulamaya bir daha güncelleme yayınlayamazsınız.
storeFile=/guvenli/dizin/hedefit-upload.jks
storePassword=
keyAlias=hedefit-upload
keyPassword=
