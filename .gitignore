# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# editor / local tooling state
/.idea/
/.claude/
/.codex/
/.openai/
/.agents/
/.cursor/
/.aider*
/AGENTS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.production is committed on purpose: it holds only NEXT_PUBLIC_* values,
# which are inlined into the client bundle at build time and are visible to
# anyone via view-source regardless. Cloudflare's CI build container has no
# .env file (that stays gitignored, for local dev only), so without this file
# committed, every production build silently ships a client with no Supabase
# config — see vite.config.ts and vinext's dotenv precedence.
!.env.production

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
