# AI plan üretimi, sohbet, öğün fotoğrafı analizi ve haftalık değerlendirme.
# OpenAI-uyumlu herhangi bir uç nokta çalışır: Moonshot (Kimi), OpenRouter,
# Together, Fireworks veya kendi vLLM/Ollama sunucunuz. Anahtar tanımlı
# değilse uygulama her yerde güvenli yerel yedeğe düşer (AI olmadan da
# çalışır, sadece kişiselleştirme azalır).
AI_API_KEY=
# Varsayılan: Moonshot AI'nin Kimi K3 modeli — native görsel girdi destekler
# (öğün fotoğrafı, plan fotoğrafı), ayrı bir görsel modele gerek yoktur.
AI_BASE_URL=https://api.moonshot.ai/v1
AI_MODEL=kimi-k3
AI_PROVIDER_NAME=moonshot
# OpenRouter kullanacaksanız örnek:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=qwen/qwen2.5-vl-72b-instruct   (OpenRouter'daki tam kimliği doğrulayın)
#   AI_PROVIDER_NAME=openrouter
#   AI_SITE_URL=https://form.ai   (OpenRouter kontrol panelinde uygulama kimliği için)

# İsteğe bağlı Supabase bağlantısı
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnız sunucu tarafındaki hesap silme işlemi için. NEXT_PUBLIC_ öneki eklemeyin.
SUPABASE_SECRET_KEY=

# Capacitor geliştirme sırasında yerel sunucu; üretimde CAPACITOR_RELEASE=1 ile
# birlikte kalıcı üretim alan adı zorunludur (bkz. README > Android yayını).
CAPACITOR_SERVER_URL=

# Supabase Auth panelinde Site URL olarak üretim alan adını,
# Redirect URLs listesine de /auth/callback adresini ekle.
