# AI plan üretimi, sohbet, öğün fotoğrafı analizi ve haftalık değerlendirme.
# OpenAI-uyumlu herhangi bir uç nokta çalışır: Moonshot (Kimi), OpenRouter,
# Together, Fireworks veya kendi vLLM/Ollama sunucunuz. Anahtar tanımlı
# değilse uygulama her yerde güvenli yerel yedeğe düşer (AI olmadan da
# çalışır, sadece kişiselleştirme azalır).
AI_API_KEY=
# Varsayılan: Moonshot AI'nin daha ekonomik Kimi K2.5 modeli. Resmi Moonshot
# uç noktasında düşünme modu otomatik kapatılarak kısa uygulama yanıtlarının
# gereksiz token tüketmesi önlenir. Öğün fotoğrafı Gemini'ye yönlendirilir.
AI_BASE_URL=https://api.moonshot.ai/v1
AI_MODEL=kimi-k2.5
AI_PROVIDER_NAME=moonshot
# OpenRouter kullanacaksanız örnek:
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=qwen/qwen2.5-vl-72b-instruct   (OpenRouter'daki tam kimliği doğrulayın)
#   AI_PROVIDER_NAME=openrouter
#   AI_SITE_URL=https://form.ai   (OpenRouter kontrol panelinde uygulama kimliği için)

# İsteğe bağlı, maliyet odaklı öğün fotoğrafı tanıma. Tanımlandığında yalnızca
# fotoğraf analizi Gemini'ye gider; diğer AI özellikleri yukarıdaki sağlayıcıda
# kalır. Gemini başarısız olursa AI_API_KEY sağlayıcısına güvenli yedekleme yapılır.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# İsteğe bağlı Supabase bağlantısı
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sunucuda hesap silme ve besin sağlayıcı cache yazımı için.
# NEXT_PUBLIC_ öneki eklemeyin.
SUPABASE_SECRET_KEY=

# İsteğe bağlı: temel besin aramasında USDA FoodData Central yedeği.
# Yalnız sunucuda kullanılır; mobil pakete eklenmez.
USDA_FDC_API_KEY=

# Fotoğraf AI özelliğini dağıtımınızda tamamen kapatmak için false yapın.
AI_VISION_ENABLED=true

# Capacitor geliştirme sırasında yerel sunucu; üretimde CAPACITOR_RELEASE=1 ile
# birlikte kalıcı üretim alan adı zorunludur (bkz. README > Android yayını).
CAPACITOR_SERVER_URL=

# Supabase Auth panelinde Site URL olarak üretim alan adını,
# Redirect URLs listesine de /auth/callback adresini ekle.
