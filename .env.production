# Committed on purpose — see the .gitignore comment above the exception for
# this file. These are NEXT_PUBLIC_* values only: they get inlined into the
# client bundle at build time and are visible to anyone via view-source in
# production regardless of where they're stored. They are not secrets:
# - the anon key is meant to be public; access control is RLS, not secrecy
# - the Supabase project URL and Google OAuth client ID are both already
#   visible in network requests and redirect URLs
#
# Do NOT add SUPABASE_SECRET_KEY, AI_API_KEY, or anything without the
# NEXT_PUBLIC_ prefix to this file — those are server-only and must stay in
# .env (local) or Cloudflare Worker secrets (production runtime), never in a
# committed file.
NEXT_PUBLIC_SUPABASE_URL=https://dqhsrabrbizwapkawmnf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_8Onvh0wma7IYqfO0Pn_2Kg_sKy-P-h5
# Discovered from the Supabase → Google OAuth redirect on 2026-07-31; update
# if a new Google OAuth client is ever created.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=755194872819-d98g7b27u8rhtipqdu962a6ehdijdku3.apps.googleusercontent.com
